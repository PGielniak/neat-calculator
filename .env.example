# MLflow Backend Store (PostgreSQL)
# For Azure: postgresql://username@servername:password@servername.postgres.database.azure.com:5432/mlflow_db
# Example: postgresql://myadmin@har-ml-postgres:MyPassword123@har-ml-postgres.postgres.database.azure.com:5432/mlflow_db
# For local: postgresql://username:password@localhost:5432/mlflow_db
MLFLOW_BACKEND_STORE_URI=sqlite:///model_training/mlflow.db

# MLflow Artifact Store (Azure Blob Storage)
# Format: wasbs://container-name@storage-account-name.blob.core.windows.net
MLFLOW_ARTIFACT_URI=./mlruns

# Azure Storage Connection String (get from Azure Portal)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-storage;AccountKey=your-key;EndpointSuffix=core.windows.net

# Optional: MLflow Tracking Server URL (if using remote server)
# MLFLOW_TRACKING_URI=http://mlflow-server:5000
